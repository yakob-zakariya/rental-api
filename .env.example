# Copy to .env and fill in real values. Never commit .env.
# All values below are dummies for local development. Secrets must be at least 32 characters,
# and the app refuses to start in production while any value still contains "change-me".

# --- App ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://rental:rental@localhost:5432/rental
REDIS_URL=redis://localhost:6379
SWAGGER_ENABLED=false      # only read in production; always on in development
JOBS_ENABLED=true          # scheduled jobs (verification polling); false in tests

# --- Auth (app users and staff use separate secrets) ---
JWT_ACCESS_SECRET=change-me-jwt-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
ADMIN_JWT_SECRET=change-me-admin-jwt-secret-at-least-32-chars
ADMIN_JWT_TTL=8h
REFRESH_REUSE_GRACE_SECONDS=60   # rule A5: retry window for a lost refresh response

# --- Identity hashing ---
ID_HASH_PEPPER=change-me-long-random-id-hash-pepper-min-32   # long random secret; never change after launch

# --- OTP / SMS ---
OTP_TTL_SECONDS=300
OTP_REQUEST_IP_LIMIT_PER_HOUR=30   # rule A8: per-IP limit on POST /auth/otp/request
ADMIN_LOGIN_IP_LIMIT_PER_15_MIN=10   # per-IP limit on POST /admin/auth/login
OTP_HASH_SECRET=change-me-long-random-otp-hash-secret-min-32   # long random secret for HMAC of OTP codes
SMS_PROVIDER=console       # 'console' logs codes in development

# --- Didit (identity verification) ---
DIDIT_API_KEY=change-me-didit-api-key
DIDIT_WEBHOOK_SECRET=change-me-didit-webhook-secret
DIDIT_WORKFLOW_ID=change-me-didit-workflow-id
DIDIT_BASE_URL=https://verification.didit.me   # confirmed (docs/didit-integration.md)
DIDIT_ENVIRONMENT=sandbox  # sandbox | live; webhook events from the other environment are rejected
APP_VERIFICATION_CALLBACK_URL=https://example.com/change-me   # where Didit sends the user back after the flow

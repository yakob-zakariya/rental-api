    {
      "name": "6. Admin",
      "description": "Staff routes. Create an account with `npm run admin:create`, put its email/password into the environment (`adminEmail`, `adminPassword`), then run **Admin login**. Admin requests send `Bearer {{adminToken}}`, never the app token.",
      "item": [
        {
          "name": "Admin login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "auth",
                "login"
              ]
            },
            "description": "200 `{ accessToken, accessTokenExpiresIn: 28800 }`; saved as `adminToken`. Every failure is 401 `INVALID_CREDENTIALS`; >10 per IP per 15 min: 429 `RATE_LIMITED`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],

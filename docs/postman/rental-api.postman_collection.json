        {
          "name": "Verification detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/verifications/{{attemptId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "verifications",
                "{{attemptId}}"
              ]
            },
            "description": "Didit's values (`provider*`) beside the effective ones, identity kinds, history.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Approve verification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/verifications/{{attemptId}}/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "verifications",
                "{{attemptId}}",
                "approve"
              ]
            },
            "description": "Moderator+. Add `documentType` + `idNumber` (+ `issuingCountry` for passports) only for an attempt with no Didit identifier; `dateOfBirth` / `fullName` correct the effective values. Errors: see the endpoint description in Swagger.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Checked in the Didit console\"\n}",

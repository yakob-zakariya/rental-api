    {
      "name": "4. Verification",
      "item": [
        {
          "name": "Start session",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/verification/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "verification",
                "sessions"
              ]
            },
            "description": "201 `{ verificationUrl, sessionToken }`; open `verificationUrl` (also saved to the environment) in a browser. Needs the sandbox Didit values in `.env` (else 503 `VERIFICATION_PROVIDER_UNAVAILABLE`). Within 30 minutes the same session is returned (V2). Other answers: 409 `ALREADY_VERIFIED` / `VERIFICATION_IN_REVIEW`, 403 `VERIFICATION_UNAVAILABLE`, 429 `VERIFICATION_RETRY_LIMIT`."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.environment.set('verificationUrl', pm.response.json().verificationUrl);"
                ]
              }
            }
          ]
        },
        {
          "name": "Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/verification/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "verification",
                "status"
              ]
            },
            "description": "200 `{ status, canRetry, retriesLeftToday, canRequestManualReview, reasonCode? }`."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Manual review request",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/verification/manual-review-request",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "verification",
                "manual-review-request"
              ]
            },
            "description": "200 with the new status (`manual_review`) only at the retry limit after a Didit decline; otherwise 409 `MANUAL_REVIEW_NOT_AVAILABLE` (or `ALREADY_VERIFIED` / `VERIFICATION_IN_REVIEW`, 403 `VERIFICATION_UNAVAILABLE`). Check \"Status\" → `canRequestManualReview` first."
          },
          "response": []
        }
      ]
    },
    {
      "name": "5. Expected failures",
      "description": "Each request here should fail; its description says how, and its test checks it.",
      "item": [
        {
          "name": "Fresh OTP code (for the next request)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/otp/request",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "otp",
                "request"
              ]
            },
            "description": "200. Sends a new code so \"Wrong OTP code\" has a live code to guess against (after \"OTP verify\" the previous code is used up). Counts toward the 3 OTP requests per phone per 10 minutes (A3): if you get 429 `OTP_RATE_LIMITED`, wait `retryAfterSeconds`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Wrong OTP code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/otp/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "otp",
                "verify"
              ]
            },
            "description": "Expect **400 `OTP_INVALID`** with `attemptsRemaining` (run the request above first; against an already-used code you get `OTP_EXPIRED` instead). Each try uses one of the code's 5 attempts (A2); after the 5th: `OTP_ATTEMPTS_EXCEEDED`. If 000000 happens to be the real code, you just signed in.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"code\": \"000000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('code OTP_INVALID', () => pm.expect(pm.response.json().code).to.eql('OTP_INVALID'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Landline number",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/otp/request",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "otp",
                "request"
              ]
            },
            "description": "Expect **400 `INVALID_PHONE`**: only Ethiopian mobile numbers (+2519…, +2517…) may sign up. No SMS is sent.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"0111234567\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('code INVALID_PHONE', () => pm.expect(pm.response.json().code).to.eql('INVALID_PHONE'));"
                ]
              }
            }
          ]
        },
        {
          "name": "fullName in PATCH /me",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me"
              ]
            },
            "description": "Expect **400 `VALIDATION_FAILED`**: name and date of birth can never be changed by the user (V9). Nothing is saved.",
            "body": {
